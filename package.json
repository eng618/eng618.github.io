    "format:ci": "prettier --check .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:report": "eslint . --cache -o ./eslintReport.html -f html",
    "start": "next start",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "validate": "bun scripts/validate.mjs"
  },
  "lint-staged": {
    "*.(js|ts|mjs|cjs)?(x)": [
