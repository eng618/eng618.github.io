{
  "name": "engarcia",
  "private": true,
  "version": "1.28.0",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "packageManager": "yarn@4.7.0",
  "scripts": {
    "build": "gatsby build",
    "build:clean": "yarn clean && gatsby build",
    "build:prod": "gatsby build --prefix-paths",
    "clean": "gatsby clean",
    "deploy": "gatsby build --prefix-paths && gh-pages -d public -b master -m \"Auto-generated commit from manual deploy\"",
    "dev": "gatsby develop -H 0.0.0.0",
    "dev:clean": "gatsby clean && gatsby develop -H 0.0.0.0",
    "dev:reset": "yarn clean && rm -rf node_modules yarn.lock && yarn && yarn test && yarn dev",
    "dev:linux": "BROWSER=/snap/bin/chromium gatsby develop -H 0.0.0.0 --open",
    "dev:check": "yarn format:fix && yarn lint:fix",
    "format": "prettier --check \"src/**/*.{scss,css,js,jsx,md,mdx}\"",
    "format:fix": "prettier --write \"src/**/*.{scss,css,js,jsx,md,mdx}\"",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "prepare": "husky install",
    "serve": "gatsby serve",
    "start": "yarn dev",
    "test": "yarn format && yarn lint"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.71.0",
    "@carbon/react": "^1.97.0",
    "@carbon/styles": "^1.96.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@mdx-js/react": "^3.1.1",
    "framer-motion": "^12.26.2",
    "gatsby": "^5.15.0",
    "gatsby-plugin-image": "^3.15.0",
    "gatsby-plugin-manifest": "^5.15.0",
    "gatsby-plugin-mdx": "^5.15.0",
    "gatsby-plugin-sharp": "^5.15.0",
    "gatsby-remark-copy-linked-files": "^6.15.0",
    "gatsby-remark-images": "^7.15.0",
    "gatsby-source-filesystem": "^5.15.0",
    "gatsby-theme-carbon": "^4.3.26",
    "gatsby-transformer-remark": "^6.15.0",
    "gatsby-transformer-sharp": "^5.15.0",
    "lmdb": "^3.4.4",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/eslint-plugin": "^7.27.1",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@eng618/prettier-config": "^2.4.12",
    "@eslint/compat": "^2.0.1",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@types/react": "^18.3.27",
    "babel-loader": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-webpack-plugin": "^5.0.2",
    "gatsby-plugin-eslint": "^4.0.4",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "webpack": "^5.103.0"
  },
  "resolutions": {
    "ansi-html": "^0.0.8",
    "cross-fetch": "^3.1.5",
    "glob-parent": "^6.0.1",
    "got": "^11.8.5",
    "node-fetch": "^2.6.7",
    "nth-check": "^2.0.1",
    "trim": "^0.0.3",
    "ws": "^7.4.6"
  },
  "lint-staged": {
    "src/**/*.(js|ts)?(x)": "eslint . --fix",
    "*.(js|md|ts)?(x)": "prettier --write",
    "*.(scss|css|json)": "prettier --write"
  },
  "prettier": "@eng618/prettier-config"
}
