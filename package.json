    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.37.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.9",
    "next": "16.2.10",
